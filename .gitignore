# Python byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & secrets
.env
.env.local
*.env
secrets.json
*.pem
*.key

# Logs and training outputs
logs/
*.log
preprocessing.log

# YOLO Training outputs and heavy weights
runs/

# Ignore model weights by default, but keep the committed demo weights
*.pt
!models/best.pt
!yolov8n.pt

# Datasets and heavy generated data
NEU-DET/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/augmented/*
!data/augmented/.gitkeep
data/yolo_dataset/*
!data/yolo_dataset/.gitkeep
data/temp_upload/*
!data/temp_upload/.gitkeep

# Detection results are ignored, except the demo seed data (charts + gallery)
results/*
!results/.gitkeep
!results/batch_results.json
!results/annotated_crazing_100.jpg
!results/annotated_crazing_102.jpg
